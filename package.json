{
  "name": "comic-creator",
  "version": "1.6.97",
  "type": "module",
  "private": true,
  "description": "AI Comic Creator - A Vite-powered PWA for generating AI-powered comic books",
  "scripts": {
    "prepare": "bash scripts/install-hooks.sh",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview --port 8080",
    "lint": "eslint src/js/",
    "lint:fix": "eslint src/js/ --fix",
    "format": "prettier --write 'src/**/*.{js,ts}' 'src/**/*.css'",
    "format:check": "prettier --check 'src/**/*.{js,ts}' 'src/**/*.css'",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:e2e": "playwright test",
    "check-syntax": "npm run typecheck && npm run build -- --logLevel error",
    "lint:actions": "bash scripts/check-actions.sh",
    "validate:workflows": "bash scripts/validate-workflows.sh",
    "version:patch": "bash scripts/bump-version.sh patch",
    "version:minor": "bash scripts/bump-version.sh minor",
    "version:major": "bash scripts/bump-version.sh major"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "nanogptjs": "^1.0.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "zod": "^4.5.4"
  }
}
